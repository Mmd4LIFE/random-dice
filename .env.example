# Telegram — create a bot via @BotFather
BOT_TOKEN=123456:ABC...

# If set, Telegram sends header X-Telegram-Bot-Api-Secret-Token; must match when calling setWebhook
WEBHOOK_SECRET=

# Postgres (point at your main server DB). Optionally use DATABASE_URL instead.
POSTGRES_HOST=postgres.example.com
POSTGRES_PORT=5432
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=telegram_bot

# Alternative single URL (overrides POSTGRES_* if set):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

LOG_LEVEL=INFO
