# Telegram — create a bot via @BotFather
BOT_TOKEN=123456:ABC...

# If set, Telegram sends header X-Telegram-Bot-Api-Secret-Token; must match when calling setWebhook
WEBHOOK_SECRET=

# Postgres — IMPORTANT FOR DOCKER:
# Inside a container, localhost is NOT your server’s Postgres; use the real hostname/IP.
# — Postgres on the same machine as Docker: POSTGRES_HOST=host.docker.internal (requires docker-compose extra_hosts; already set).
# — Postgres on another host: use its hostname or IP (e.g. db.mycompany.internal).
# Ensure Postgres listens on the network (not only 127.0.0.1) and pg_hba.conf allows the Docker bridge subnet if needed.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=telegram_bot

# Alternative single URL (overrides POSTGRES_* if set):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

LOG_LEVEL=INFO

# true = getUpdates long polling (works behind firewall; recommended for Docker unless you use HTTPS webhook).
# false = expect Telegram POST https://your-domain/webhook (needs TLS + open firewall).
USE_POLLING=true
